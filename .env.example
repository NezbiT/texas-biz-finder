# TX BizFinder — copy to .env and adjust (https://www.txbizfinder.com)
# Antes de Cloudflare Tunnel: cambia ADMIN_API_KEY a un valor largo y secreto.

ADMIN_API_KEY=admin-dev-key-change-me
MAX_EMPLOYEES_SMALL_BIZ=50

# --- Local (DuckDB + SQLite overlay) ---
# DATABASE_URL=sqlite:///data/texasbizfinder.db
# DATA_BACKEND=csv
# FRANCHISE_CSV_PATH=data/raw/texas_franchise_taxpayers.csv
# BEVERAGE_CSV_PATH=data/raw/mixed_beverage_receipts.csv
# PROCESSED_CSV_PATH=data/processed/texas_leads_processed.csv
# PROCESSED_DUCKDB_PATH=data/processed/texas_leads.duckdb

# --- Supabase (PostgreSQL en la nube) ---
# 1. Crea proyecto en https://supabase.com
# 2. Settings → Database → Connection string → URI (pooler, puerto 6543)
# 3. Migra datos: python -m scripts.migrate_to_supabase --force
DATA_BACKEND=supabase
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Single-port prod mode: python run.py --prod --build
SERVE_FRONTEND=false
FRONTEND_DIST_PATH=frontend/dist

# Playwright (website research)
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_NAV_TIMEOUT_MS=25000