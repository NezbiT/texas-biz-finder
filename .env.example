# TexasBizFinder v2 — copy to .env and adjust

ADMIN_API_KEY=admin-dev-key-change-me
DATABASE_URL=sqlite:///data/texasbizfinder.db
MAX_EMPLOYEES_SMALL_BIZ=50

# Data backend: csv (DuckDB + bulk pipeline) or sqlite (legacy demo DB)
DATA_BACKEND=csv
FRANCHISE_CSV_PATH=data/raw/texas_franchise_taxpayers.csv
BEVERAGE_CSV_PATH=data/raw/mixed_beverage_receipts.csv
PROCESSED_CSV_PATH=data/processed/texas_leads_processed.csv
PROCESSED_DUCKDB_PATH=data/processed/texas_leads.duckdb

# Playwright (website research)
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_NAV_TIMEOUT_MS=25000