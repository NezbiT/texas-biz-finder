# TX BizFinder / TxBizFinder Intelligence
# Single domain + paths (no subdomains, no Cloudflare Tunnel to a home PC).
# Frontend env: frontend-v2/.env  (keep ADMIN_API_KEY == NUXT_PUBLIC_ADMIN_API_KEY)

APP_ENV=development
ADMIN_API_KEY=admin-dev-key-change-me
MAX_EMPLOYEES_SMALL_BIZ=50

# --- Data backend ---
DATA_BACKEND=csv
DATABASE_URL=sqlite:///data/texasbizfinder.db
FRANCHISE_CSV_PATH=data/raw/texas_franchise_taxpayers.csv
BEVERAGE_CSV_PATH=data/raw/mixed_beverage_receipts.csv
PROCESSED_CSV_PATH=data/processed/texas_leads_processed.csv
PROCESSED_DUCKDB_PATH=data/processed/texas_leads.duckdb

UVICORN_WORKERS=1
DUCKDB_THREADS=2
DUCKDB_MEMORY_LIMIT=1GB
ENABLE_WEBSITE_RESEARCH=true
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_NAV_TIMEOUT_MS=25000

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://www.txbizfinder.com","https://txbizfinder.com","https://txbizfinder-web.vercel.app"]

# Suite — path-based public URLs
SUITE_WWW_URL=https://www.txbizfinder.com
SUITE_RADAR_URL=https://www.txbizfinder.com/radar
SUITE_CHANNEL_URL=https://www.txbizfinder.com/channel
SUITE_SENTINEL_URL=https://www.txbizfinder.com/sentinel

# Production (Oracle)
# APP_ENV=production
# ADMIN_API_KEY=<openssl rand -hex 32>
# ENABLE_WEBSITE_RESEARCH=false
