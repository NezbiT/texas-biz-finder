# Frontend (Vite) — copy to frontend/.env
# Must match backend ADMIN_API_KEY in repo-root .env

VITE_ADMIN_API_KEY=admin-dev-key-change-me

# Empty = same-origin /api (recommended: Vite proxy in dev, FastAPI in --prod)
# VITE_API_BASE_URL=https://api.txbizfinder.com

# Dev proxy target when using relative /api (vite.config.ts)
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# TxBizFinder Intelligence — product URLs
VITE_SUITE_WWW_URL=https://www.txbizfinder.com
VITE_SUITE_BIZ_APP_PATH=/app
VITE_SUITE_RADAR_URL=https://radar.txbizfinder.com
VITE_SUITE_CHANNEL_URL=https://channel.txbizfinder.com
VITE_SUITE_SENTINEL_URL=https://sentinel.txbizfinder.com
VITE_SUITE_FLOOD_URL=https://flood.txbizfinder.com
VITE_SUITE_POWER_URL=https://power.txbizfinder.com
VITE_SUITE_MAP_URL=https://map.txbizfinder.com
