# Same secret as backend ADMIN_API_KEY
NUXT_PUBLIC_ADMIN_API_KEY=admin-dev-key-change-me

# SSR on Vercel must reach Oracle FastAPI directly (Worker also exposes /api publicly).
# NUXT_API_PROXY_URL=https://YOUR-ORACLE-HTTPS-ORIGIN

# Suite paths under one domain (defaults already set in nuxt.config)
NUXT_PUBLIC_SUITE_WWW_URL=https://www.txbizfinder.com
NUXT_PUBLIC_SUITE_BIZ_APP_PATH=/app
NUXT_PUBLIC_SUITE_RADAR_URL=https://www.txbizfinder.com/radar
NUXT_PUBLIC_SUITE_CHANNEL_URL=https://www.txbizfinder.com/channel
NUXT_PUBLIC_SUITE_SENTINEL_URL=https://www.txbizfinder.com/sentinel
NUXT_PUBLIC_SUITE_FLOOD_URL=https://www.txbizfinder.com/flood
NUXT_PUBLIC_SUITE_POWER_URL=https://www.txbizfinder.com/power
NUXT_PUBLIC_SUITE_MAP_URL=https://www.txbizfinder.com/map
