# API key que el frontend envía en el header X-API-Key (misma del backend)
NUXT_PUBLIC_ADMIN_API_KEY=admin-dev-key-change-me

# Producción: URL del backend FastAPI al que Nitro reenvía /api/**
# (en dev no hace falta: el devProxy apunta a http://127.0.0.1:8000)
# NUXT_API_PROXY_URL=https://txbizfinder-api.onrender.com
